# Uploaded files must never be treated as executable scripts.
Options -Indexes -ExecCGI

<FilesMatch "\\.(?i:php[0-9]*|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>

# Prevent content sniffing when uploaded files are served.
Header always set X-Content-Type-Options "nosniff"
